{
  "project": "RC",
  "note": "Derived from the codes already in use. Replace with the approved coding structure per project; the app compiles these patterns at runtime, so no code change is needed.",
  "asset": {
    "pattern": "{TYPE}-{SERIES}-{SEQUENCE}",
    "childPattern": "{PARENT}-{TYPE}-{SERIES}-{SEQUENCE}",
    "segment": "[A-Z]{2,4}-\\d{3}-\\d{4}",
    "seriesLength": 3,
    "sequenceLength": 4,
    "defaultSeries": "100",
    "types": [
      { "code": "SSU", "name": "Split Unit" },
      { "code": "WWU", "name": "Window / Wall Unit" },
      { "code": "FCU", "name": "Fan Coil Unit" },
      { "code": "RGS", "name": "Register / Grille" },
      { "code": "AHU", "name": "Air Handling Unit" },
      { "code": "PKU", "name": "Package Unit" },
      { "code": "FDA", "name": "Fire Damper" },
      { "code": "PMP", "name": "Pump" },
      { "code": "DBD", "name": "Distribution Board" },
      { "code": "LGT", "name": "Lighting Fixture" }
    ]
  },
  "location": {
    "pattern": "{PROJECT}-{SITE}-{BUILDING}-{FLOOR}-{ROOM}",
    "segment": "[A-Z]{2}-\\d{4}-[A-Z]{2,3}-\\d{3}(-\\d{2}(-[A-Z0-9]{2,4})?)?",
    "siteLength": 4,
    "buildingNumberLength": 3,
    "floorLength": 2,
    "roomLength": 3
  }
}
