PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=change-this-before-production
JWT_EXPIRES_IN=8h
TRUST_PROXY=false
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_MAX_KEYS=10000
SMTP_TLS_REJECT_UNAUTHORIZED=true
CONNECTOR_SECRET_KEY=

ADMIN_USER_ID=USR-ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_EMAIL=admin@example.com

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=CafmV3
MSSQL_USER=cafm_app
MSSQL_PASSWORD=yourStrong(!)Password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_CONNECTION_TIMEOUT=10000
MSSQL_REQUEST_TIMEOUT=30000
MSSQL_POOL_MAX=20
MSSQL_POOL_MIN=2
MSSQL_POOL_IDLE_TIMEOUT_MS=30000
MSSQL_POOL_ACQUIRE_TIMEOUT_MS=15000

PM_SCHEDULER_ENABLED=true
PM_SCHEDULER_INTERVAL_MS=20000
PM_SCHEDULER_BATCH_SIZE=100
PM_SCHEDULER_CONCURRENCY=4

PERMISSION_CACHE_TTL_MS=5000
PERMISSION_CACHE_MAX_ENTRIES=10000
LIST_MAX_PAGE_SIZE=500
JSON_BODY_LIMIT=10mb
SOCKET_MAX_BUFFER_BYTES=1048576
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_STORAGE_PATH=storage/attachments

SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000
